PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Atlas verifies database certificates by default for non-local databases.
# Localhost defaults to TLS disabled. Hosted deployments should use verify-full.
# DATABASE_SSL_MODE=verify-full
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Required in production. Use a high-entropy secret of at least 32 bytes.
ATLAS_SESSION_SECRET=replace-with-a-long-random-secret

# Used only when no admin account exists. Remove the password from the runtime
# environment after the first successful bootstrap if your platform permits it.
# ATLAS_BOOTSTRAP_ADMIN_USERNAME=admin
# ATLAS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Exact browser origins allowed to call the API. FRONTEND_URL is the primary UI.
FRONTEND_URL=http://localhost:5173
# ADDITIONAL_ALLOWED_ORIGINS=https://preview.example.com,https://admin.example.com

# Emergency-only escape hatch for a trusted private database that cannot present
# a verifiable certificate. Do not enable this for public/Internet deployments.
# ATLAS_ALLOW_INSECURE_DB_TLS=false

# Optional Google Sheets service-account credentials as a single-line JSON object.
# Alternatively use an untracked backend/google-credentials.json file.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"YOUR_PROJECT",...}
