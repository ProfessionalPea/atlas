PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Production requires a random value with at least 32 bytes of entropy.
# Leave blank for local development to use a temporary secret; sessions reset on restart.
ATLAS_SESSION_SECRET=

# Optional connection pool cap; all backend modules share this pool.
ATLAS_DB_POOL_MAX=10

# Remote databases verify TLS certificates by default. Localhost defaults to TLS off.
# DATABASE_SSL_MODE=verify-full
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Only needed on the first production start if no non-default admin account exists.
# Configure a unique username/password in the deployment environment, not in Git.
ATLAS_BOOTSTRAP_ADMIN_USERNAME=
ATLAS_BOOTSTRAP_ADMIN_PASSWORD=

# Exact browser origin(s) allowed to call the API.
FRONTEND_URL=http://localhost:5173
# ADDITIONAL_ALLOWED_ORIGINS=https://trusted-preview.example.com,https://admin.example.com

# Emergency-only: do not enable for public/Internet deployments.
ATLAS_ALLOW_INSECURE_DB_TLS=false

# Optional Google Sheets service-account credentials as a single-line JSON object.
# Alternatively use an untracked backend/google-credentials.json file.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"YOUR_PROJECT",...}
